[run]
source = .
relative_files = True
branch = True
omit =
    */migrations/*
    */tests.py
    */test_*.py
    */__pycache__/*
    */.venv/*
    */venv/*
    */env/*
    */.pytest_cache/*
    */manage.py
    */wsgi.py
    */asgi.py
    */settings.py
    */urls.py
    */.coverage*

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[xml]
output = coverage.xml
package_depth = 2
